# Copy to .env.local for local development. Set the same variables in Vercel → Project → Settings → Environment Variables.

# Public, non-secret. Canonical production origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.baidencreatives.org

# Project inquiry delivery (server only, never exposed to the browser).
# Create an API key at https://resend.com and verify the sending domain first.
RESEND_API_KEY=
# Inbox that receives project inquiries.
INQUIRY_TO_EMAIL=edstudios77@gmail.com
# Sender address on a domain verified in Resend, e.g. "Baiden Creatives <projects@baidencreatives.org>".
INQUIRY_FROM_EMAIL=
